# ---------------------------------------------------------------------------
# Editor workstation .env  --  everything runs locally on this machine.
# Copy to `.env` in this folder (setup-workstation.ps1 does it for you).
# Real environment variables override these. Only two services:
#   vision      -> local Ollama, gemma4
#   transcript  -> local Canary ASR server (helpers/canary_server.py, :8002)
# ---------------------------------------------------------------------------

# --- Vision (local Ollama) ----------------------------------------------
# Pull it first:  ollama pull gemma4:12b
OLLAMA_VISION_MODEL=gemma4:12b
OLLAMA_URL=http://localhost:11434

# Alternative: route vision through a shared remote LiteLLM proxy instead of
# a local Ollama install on this machine. No code change needed either way -
# visual_connector.py tries the OpenAI-compatible /chat/completions route on
# OLLAMA_URL before falling back to native Ollama, so a LiteLLM proxy URL
# works here too. To use it: comment out the two OLLAMA_* lines above and
# uncomment the two below. Only works if this machine can actually reach
# that host (same network/VPN) - not over the open internet without that.
# OLLAMA_VISION_MODEL=gemma4-31b
# OLLAMA_URL=http://bigdata.prima-net.cz:56768

# --- Transcription (local Canary ASR server) ---------------------------
# Start it:  .venv\Scripts\python.exe helpers\canary_server.py --port 8002
# Canary speaks the same /v1/transcribe contract as the "nemo" backend, so
# run main.py with `--asr-backend nemo` and this URL.
NEMO_URL=http://localhost:8002/v1/transcribe
NEMO_API_KEY=
NEMO_MODEL_NAME=nvidia-canary-1b-v2
# No HF_TOKEN needed: Canary + streaming-Sortformer diarization are ungated.
HF_TOKEN=

# --- Where editor output workspaces live on this machine ---------------
AI_EDITS_ROOT=%USERPROFILE%\Documents\AI-edits
LOCAL_OVERRIDE=true

# --- Benchmark CSV (optional) -----------------------------------------
# Unset -> analysis_runs.csv next to main.py. Set to a shared path to pool
# every editor machine's timing rows into one file.
ANALYTICS_CSV=
DEPLOYMENT=
